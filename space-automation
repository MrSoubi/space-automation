#!/usr/bin/env python3
# Prefer the project's installed UI dependencies without requiring activation.
import os
from pathlib import Path
import sys

venv = Path(__file__).resolve().parent / '.venv'
if (venv / 'bin/python').exists() and Path(sys.prefix) != venv:
    os.execv(str(venv / 'bin/python'), [str(venv / 'bin/python'), __file__, *sys.argv[1:]])

from space_automation.terminal import main

if __name__ == '__main__':
    raise SystemExit(main())
